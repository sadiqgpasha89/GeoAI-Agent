# Copy to .env (docker compose reads it). Never commit real keys.

# ---- runtime ---------------------------------------------------------------
GEOAI_ENV=development                 # production => GEOAI_API_KEYS is mandatory
GEOAI_LOG_LEVEL=INFO

# ---- security --------------------------------------------------------------
# "key:tenant,key2:tenant2". Tenants are fully isolated (assets, analyses, reviews).
GEOAI_API_KEYS=
GEOAI_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GEOAI_MAX_UPLOAD_MB=25
GEOAI_RATE_LIMIT_PER_MINUTE=120
# GEOAI_CLAMAV_HOST=clamav            # optional malware scanning (fail-closed)

# ---- models (leave empty => offline demo engine) ----------------------------
ANTHROPIC_API_KEY=
GEOAI_MODEL_FAST=claude-haiku-5-5     # routing / planning
GEOAI_MODEL_VISION=claude-sonnet-5-5  # VLM + synthesis
# OpenAI-compatible endpoint (vLLM / Ollama / Azure proxy) for local or data-resident inference:
# GEOAI_PROVIDER=openai_compat
# GEOAI_OPENAI_BASE_URL=http://vllm:8000/v1
# GEOAI_OPENAI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# GEOAI_OPENAI_API_KEY=

# ---- persistence -------------------------------------------------------------
# SQLite file under GEOAI_DATA_DIR by default. For PostgreSQL install the `postgres` extra:
# GEOAI_DATABASE_URL=postgresql+psycopg://geoai:geoai@postgres:5432/geoai

# ---- optional external data ---------------------------------------------------
GEOAI_ENABLE_EXTERNAL_DATA=false      # true => live weather (Open-Meteo) for georeferenced scenes
